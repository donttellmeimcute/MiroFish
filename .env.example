# ===== LLM provider selection =====
# Supported values: openai | ollama | gemini
# Default: openai  (any API that speaks the OpenAI protocol)
LLM_PROVIDER=openai

# ===== OpenAI-compatible API (LLM_PROVIDER=openai) =====
# Works with OpenAI, Alibaba Qwen, MiniMax, and any OpenAI-compatible endpoint.
# Recommended: Alibaba Bailian qwen-plus model: https://bailian.console.aliyun.com/
# This can consume significant credits; try simulations under 40 rounds first.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Ollama (LLM_PROVIDER=ollama) =====
# Runs models locally — no API key required.
# Install Ollama: https://ollama.com/  then run: ollama pull llama3.2
# Install extra dependency first: cd backend && uv pip install "mirofish-backend[ollama]"
#
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434   # default Ollama address
# LLM_MODEL_NAME=llama3.2

# ===== Google Gemini (LLM_PROVIDER=gemini) =====
# Get a free API key at: https://aistudio.google.com/app/apikey
# Install extra dependency first: cd backend && uv pip install "mirofish-backend[gemini]"
#
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_google_api_key_here
# LLM_MODEL_NAME=gemini-2.0-flash

# ===== ZEP memory graph configuration =====
# The free monthly quota is enough for light usage: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Accelerated LLM configuration (optional) =====
# If you do not use acceleration, remove the configuration entries below from your .env file.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here